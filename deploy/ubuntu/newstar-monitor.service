[Unit]
Description=NewStar health, backup and queue monitor
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/newstar/monitor.env
Environment=NEWSTAR_ACCOUNT_USER=newstar-account
Environment=NEWSTAR_ATLAS_USER=newstar-atlas
ExecStart=/usr/bin/python3 /opt/newstar/current/scripts/watchdog.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newstar
